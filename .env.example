# --- Режим работы SKYNET ---
# local  — без API и без вложений, через локальные модели Ollama.
# cloud  — Claude/GPT через API-ключи.
# hybrid — использует cloud, если ключи есть; иначе падает в local.
SKYNET_MODE=local
LOCAL_DEFAULT_MODEL=ollama/llama3.1:8b
OLLAMA_API_BASE=http://127.0.0.1:11434
DEFAULT_DEPARTMENT=coders

# --- Ключи LLM-провайдеров (нужны только для cloud/hybrid с облаком) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Диспетчер института (определяет, какой отдел обрабатывает запрос) ---
ROUTER_MODEL=claude-haiku-4-5

# --- Отдел "Кодеры" (agent_factory) ---
CODERS_ARCHITECT_MODEL=anthropic/claude-opus-5
CODERS_CODER_MODEL=anthropic/claude-sonnet-5
CODERS_RESEARCHER_MODEL=openai/gpt-5
CODERS_REVIEWER_MODEL=anthropic/claude-sonnet-5
CODERS_DEVOPS_MODEL=openai/gpt-5-mini
CODERS_LEARNER_MODEL=anthropic/claude-haiku-4-5

# --- Отдел "Маркетинг + Копирайтеры" (marketing_dept) ---
STRATEGIST_MODEL=anthropic/claude-sonnet-5
COPYWRITER_MODEL=anthropic/claude-opus-5
SEO_MODEL=anthropic/claude-sonnet-5
EDITOR_MODEL=anthropic/claude-sonnet-5
MARKETING_LEARNER_MODEL=anthropic/claude-haiku-4-5

# --- Отдел "Дизайнеры" (design_dept) ---
REFERENCE_ANALYST_MODEL=anthropic/claude-sonnet-5
DESIGN_SYSTEM_MODEL=anthropic/claude-opus-5
FRONTEND_CODER_MODEL=anthropic/claude-opus-5
DESIGN_REVIEWER_MODEL=anthropic/claude-sonnet-5
DESIGN_LEARNER_MODEL=anthropic/claude-haiku-4-5
# Модель для vision-анализа референсов (вызывается напрямую через Anthropic SDK)
DESIGN_VISION_MODEL=claude-opus-5
# Папка со скриншотами-референсами (Pinterest/Dribbble/Awwwards/Godly и т.п.)
REFERENCES_DIR=./references
# Куда сохранять дизайн-систему и готовый index.html
DESIGN_OUTPUT_DIR=./generated_designs

# --- Отдел контроля качества (quality_control_dept) ---
ENABLE_QUALITY_GATE=1
QC_REQUIREMENTS_MODEL=anthropic/claude-sonnet-5
QC_RISK_MODEL=anthropic/claude-sonnet-5
QC_FINAL_EDITOR_MODEL=anthropic/claude-sonnet-5
QC_LEARNER_MODEL=anthropic/claude-haiku-4-5

# --- Самообучение: где хранить локальную базу знаний/уроков ---
KNOWLEDGE_DIR=./knowledge

# --- Оценка качества (LLM-as-Judge) перед записью уроков самообучения ---
JUDGE_MODEL=claude-haiku-4-5

# --- Трассировка: локальный лог шагов каждого прогона (traces/<отдел>_<дата>.jsonl) ---
TRACES_DIR=./traces

# --- Единая политика выполнения агентов ---
AGENT_MAX_ITER=8
AGENT_MAX_RETRY_LIMIT=2
AGENT_MAX_RPM=20
AGENT_MAX_EXECUTION_TIME=900
# CrewAI memory требует embeddings и поэтому включается отдельно.
ENABLE_CREW_MEMORY=0

# --- История запусков института ---
RUNS_DIR=./runs

# --- Служебное состояние (например, реальный вердикт ревью для гварда на деплой) ---
STATE_DIR=./.state

# --- Опционально: веб-поиск для Исследователя (crewai-tools SerperDevTool) ---
SERPER_API_KEY=

# --- Куда сохранять сгенерированных агентов (отдел Кодеров) ---
OUTPUT_DIR=./generated_agents

# --- Безопасный запуск сгенерированных агентов ---
# Секреты передаются в контейнер только из whitelist, а не всем .env целиком.
GENERATED_AGENT_ENV_ALLOWLIST=ANTHROPIC_API_KEY,OPENAI_API_KEY,SERPER_API_KEY
GENERATED_AGENT_MEMORY=512m
GENERATED_AGENT_CPUS=1.0
GENERATED_AGENT_NETWORK=bridge
