# --- Режим работы SKYNET ---
# local  — без API и без вложений, через локальные модели Ollama.
# cloud  — Claude/GPT через API-ключи.
# hybrid — использует cloud, если ключи есть; иначе падает в local.
SKYNET_MODE=cloud
CLOUD_DEFAULT_MODEL=openai/gpt-4o-mini
OPENAI_DEFAULT_MODEL=gpt-4o-mini
LOCAL_DEFAULT_MODEL=ollama/llama3.2:1b
OLLAMA_API_BASE=http://127.0.0.1:11434
DEFAULT_DEPARTMENT=coders

# --- Ключи LLM-провайдеров (нужны только для cloud/hybrid с облаком) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Диспетчер института (определяет, какой отдел обрабатывает запрос) ---
ROUTER_MODEL=claude-haiku-4-5
OPENAI_ROUTER_MODEL=gpt-4o-mini

# --- Отдел "Кодеры" (agent_factory) ---
CODERS_ARCHITECT_MODEL=openai/gpt-4o-mini
CODERS_CODER_MODEL=openai/gpt-4o-mini
CODERS_RESEARCHER_MODEL=openai/gpt-4o-mini
CODERS_REVIEWER_MODEL=openai/gpt-4o-mini
CODERS_DEVOPS_MODEL=openai/gpt-4o-mini
CODERS_LEARNER_MODEL=openai/gpt-4o-mini

# --- Отдел "Маркетинг + Копирайтеры" (marketing_dept) ---
STRATEGIST_MODEL=openai/gpt-4o-mini
COPYWRITER_MODEL=openai/gpt-4o-mini
SEO_MODEL=openai/gpt-4o-mini
EDITOR_MODEL=openai/gpt-4o-mini
MARKETING_LEARNER_MODEL=openai/gpt-4o-mini

# --- Отдел "Дизайнеры" (design_dept) ---
REFERENCE_ANALYST_MODEL=openai/gpt-4o-mini
DESIGN_SYSTEM_MODEL=openai/gpt-4o-mini
FRONTEND_CODER_MODEL=openai/gpt-4o-mini
DESIGN_REVIEWER_MODEL=openai/gpt-4o-mini
DESIGN_LEARNER_MODEL=openai/gpt-4o-mini
# Модели для vision-анализа референсов
DESIGN_VISION_MODEL=claude-opus-5
OPENAI_VISION_MODEL=gpt-4o-mini
# Папка со скриншотами-референсами (Pinterest/Dribbble/Awwwards/Godly и т.п.)
REFERENCES_DIR=./references
# Куда сохранять дизайн-систему и готовый index.html
DESIGN_OUTPUT_DIR=./generated_designs

# --- Отдел контроля качества (quality_control_dept) ---
ENABLE_QUALITY_GATE=1
QC_REQUIREMENTS_MODEL=openai/gpt-4o-mini
QC_RISK_MODEL=openai/gpt-4o-mini
QC_FINAL_EDITOR_MODEL=openai/gpt-4o-mini
QC_LEARNER_MODEL=openai/gpt-4o-mini

# --- Самообучение: где хранить локальную базу знаний/уроков ---
KNOWLEDGE_DIR=./knowledge

# --- Оценка качества (LLM-as-Judge) перед записью уроков самообучения ---
JUDGE_MODEL=claude-haiku-4-5
OPENAI_JUDGE_MODEL=gpt-4o-mini

# --- Трассировка: локальный лог шагов каждого прогона (traces/<отдел>_<дата>.jsonl) ---
TRACES_DIR=./traces

# --- Единая политика выполнения агентов ---
AGENT_MAX_ITER=8
AGENT_MAX_RETRY_LIMIT=2
AGENT_MAX_RPM=20
AGENT_MAX_EXECUTION_TIME=900
# CrewAI memory требует embeddings и поэтому включается отдельно.
ENABLE_CREW_MEMORY=0

# --- История запусков института ---
RUNS_DIR=./runs

# --- Telegram-бот для задач SKYNET ---
TELEGRAM_BOT_TOKEN=
# Опционально: список Telegram user_id через запятую. Пусто = принимать всех.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_TASK_QUEUE_SIZE=20
TELEGRAM_DEFAULT_MODE=fast
FAST_MODE_PROVIDER=auto
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_MODEL_FALLBACKS=gpt-4.1-mini,gpt-4o-mini
TELEGRAM_TASK_TIMEOUT=600
TELEGRAM_PROGRESS_INTERVAL=5
FAST_MODE_TIMEOUT=90
FAST_MODE_NUM_CTX=2048
FAST_MODE_NUM_PREDICT=384
FAST_MODE_TEMPERATURE=0.3

# --- Служебное состояние (например, реальный вердикт ревью для гварда на деплой) ---
STATE_DIR=./.state

# --- Опционально: веб-поиск для Исследователя (crewai-tools SerperDevTool) ---
SERPER_API_KEY=

# --- Куда сохранять сгенерированных агентов (отдел Кодеров) ---
OUTPUT_DIR=./generated_agents

# --- Безопасный запуск сгенерированных агентов ---
# Секреты передаются в контейнер только из whitelist, а не всем .env целиком.
GENERATED_AGENT_ENV_ALLOWLIST=ANTHROPIC_API_KEY,OPENAI_API_KEY,SERPER_API_KEY
GENERATED_AGENT_MEMORY=256m
GENERATED_AGENT_CPUS=0.5
GENERATED_AGENT_NETWORK=bridge
